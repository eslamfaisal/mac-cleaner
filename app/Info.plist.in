<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>                 <string>Mac Cleaner</string>
  <key>CFBundleDisplayName</key>          <string>Mac Cleaner</string>
  <key>CFBundleIdentifier</key>           <string>com.eslamfaisal.mac-cleaner</string>
  <key>CFBundleExecutable</key>           <string>Mac Cleaner</string>
  <key>CFBundleIconFile</key>             <string>AppIcon</string>
  <key>CFBundlePackageType</key>          <string>APPL</string>
  <key>CFBundleShortVersionString</key>   <string>@VERSION@</string>
  <key>CFBundleVersion</key>              <string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key>       <string>12.0</string>
  <key>LSApplicationCategoryType</key>    <string>public.app-category.utilities</string>
  <key>NSHumanReadableCopyright</key>     <string>Open source (MIT) — github.com/eslamfaisal/mac-cleaner</string>
  <key>NSHighResolutionCapable</key>      <true/>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>    <true/>
  </dict>
  <!-- The scan reads Desktop, Documents, Downloads and any mounted volume's
       Trash. Without these, macOS still asks — it just asks with a blank
       reason, which is exactly when people decline and then get a short scan
       with no explanation. Not NSNetworkVolumesUsageDescription: the volume
       scan anchors on /dev/disk, which excludes smbfs and nfs. -->
  <key>NSDesktopFolderUsageDescription</key>
  <string>Mac Cleaner looks for large and duplicate files on your Desktop. Nothing is deleted unless you select it and confirm.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Mac Cleaner looks for large and duplicate files in your Documents. Nothing is deleted unless you select it and confirm.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Mac Cleaner looks for old installers and large downloads you no longer need. Nothing is deleted unless you select it and confirm.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Mac Cleaner reports how much space the Trash on a connected disk is still using. Nothing is deleted unless you select it and confirm.</string>
</dict>
</plist>
